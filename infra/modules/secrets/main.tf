# The JWT signing key for the backend, generated by AWS and stored in Secrets Manager.
#
# The value never enters Terraform state or plan output: it is generated by an ephemeral resource
# (it exists only while Terraform runs) and written through a write-only argument. Write-only
# arguments need Terraform 1.11 or later. To rotate the key, increase var.secret_version.

ephemeral "aws_secretsmanager_random_password" "jwt" {
  password_length     = 64
  exclude_punctuation = true
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${var.name_prefix}-jwt-secret"
  description             = "JWT signing key for the ${var.name_prefix} backend"
  recovery_window_in_days = var.recovery_window_in_days
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id                = aws_secretsmanager_secret.jwt.id
  secret_string_wo         = ephemeral.aws_secretsmanager_random_password.jwt.random_password
  secret_string_wo_version = var.secret_version
}
