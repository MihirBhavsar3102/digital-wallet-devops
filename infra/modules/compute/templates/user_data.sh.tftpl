#!/bin/bash
set -eux
export DEBIAN_FRONTEND=noninteractive
snap wait system seed.loaded

# Ubuntu's apt mirrors default to plain HTTP (port 80), but the app security group only allows
# outbound HTTPS, so apt could not download Ubuntu's package indexes or security updates.
# Switch them to HTTPS before the first apt-get update. "|| true" keeps a renamed or missing
# sources file on a future image from aborting the whole boot.
sed -i '/^URIs:/ s|http://|https://|g' /etc/apt/sources.list.d/*.sources || true

apt-get update
# rsyslog writes /var/log/syslog and /var/log/auth.log, the two files the CloudWatch agent ships. It is
# listed here so that those files exist whatever the image includes; on an image that has it, this is a no-op.
apt-get install -y ca-certificates curl gnupg unzip rsyslog

# --- Docker Engine and the Compose plugin (Docker's official apt repository)
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# --- AWS CLI: deploy.sh uses it for the ECR login and Secrets Manager.
# AWS's own installer, not "snap install aws-cli": on 2026-11-11 the Snap store was unreachable (from this
# VPC and from elsewhere), "snap install" failed with "unable to contact snap store", and because this
# script stops at the first error no instance could finish booting: each one failed its health check
# and was replaced by one that failed the same way. awscli.amazonaws.com is AWS's own distribution
# point. The installer puts the command in /usr/local/bin, which is on every shell's default PATH,
# including the one SSM Run Command starts.
curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

# --- CloudWatch agent: memory and disk metrics, and /var/log/syslog and /var/log/auth.log.
# Its configuration is monitoring/cloudwatch-agent.json, stored in Parameter Store by the monitoring module.
curl -fsSL -o /tmp/amazon-cloudwatch-agent.deb https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
dpkg -i -E /tmp/amazon-cloudwatch-agent.deb
rm -f /tmp/amazon-cloudwatch-agent.deb
# fetch-config loads the parameter, -s starts the agent (and enables it for the next reboot). Not fatal: this
# script stops at its first error, and an instance that never finishes booting is replaced by one that fails
# the same way (see "Boot without the Snap store" in the README). An instance without monitoring still serves
# traffic, and an alarm on the missing metrics tells someone about it.
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c ssm:${agent_config_parameter} \
  || echo "the CloudWatch agent did not start: this instance runs without memory and disk metrics and system logs"

# --- Who this instance is. IMDSv2 is required on these instances, so the metadata calls need a session token.
TOKEN=$(curl -s -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

# --- /opt/app, instance settings and deploy.sh
mkdir -p /opt/app/placeholder
# deploy.sh sources this file. None of the values is secret (the database password stays in
# Secrets Manager). The ARN contains "!", so the database values are quoted. The instance ID and the
# log group names are where deploy.sh sends the containers' logs: the stream is the instance ID, as for
# the CloudWatch agent's syslog and auth logs.
cat > /opt/app/instance.env <<ENV_EOF
REGION=${region}
ACCOUNT_ID=${account_id}
NAME_PREFIX=${name_prefix}
FRONTEND_PORT=${frontend_port}
BACKEND_PORT=${backend_port}
DB_HOST="${db_host}"
DB_PORT="${db_port}"
DB_NAME="${db_name}"
DB_SECRET_ARN="${db_secret_arn}"
INSTANCE_ID=$INSTANCE_ID
BACKEND_LOG_GROUP=${backend_log_group}
FRONTEND_LOG_GROUP=${frontend_log_group}
ENV_EOF
echo "${deploy_script_b64}" | base64 -d > /opt/app/deploy.sh
chmod 0750 /opt/app/deploy.sh

# --- Placeholder container: lets load balancer health checks pass before the first real deploy.
cat > /opt/app/placeholder/index.html <<HTML_EOF
<!doctype html><title>Digital Wallet placeholder</title>
<h1>Digital Wallet: placeholder</h1>
<p>No application has been deployed yet.</p>
<p>Served by instance $INSTANCE_ID in $AZ</p>
HTML_EOF

cat > /opt/app/placeholder/default.conf <<'CONF_EOF'
server {
  listen ${frontend_port};
  listen ${backend_port};
  root /usr/share/nginx/html;
  location /api { default_type text/plain; return 200 'placeholder ok'; }
  location / { try_files $uri /index.html; }
}
CONF_EOF

docker run -d --name placeholder --restart unless-stopped \
  -p ${frontend_port}:${frontend_port} -p ${backend_port}:${backend_port} \
  -v /opt/app/placeholder/default.conf:/etc/nginx/conf.d/default.conf:ro \
  -v /opt/app/placeholder/index.html:/usr/share/nginx/html/index.html:ro \
  public.ecr.aws/nginx/nginx:stable-alpine

# --- Converge to the last release that passed its smoke test.
# The pipeline records the tag of every verified deploy in this parameter (cd.yml). Without this, a
# replacement instance (a failed health check, an instance refresh, a scale-out) would serve the
# placeholder until the next deploy. "none" means nothing has been deployed yet. A failure here is not
# fatal: the placeholder keeps the instance healthy for the load balancer and the next deploy fixes it.
RELEASE_TAG=$(aws ssm get-parameter --region ${region} --name "/${name_prefix}/deployed-tag" --query Parameter.Value --output text) || RELEASE_TAG=none
if [ "$RELEASE_TAG" != "none" ]; then
  /opt/app/deploy.sh "$RELEASE_TAG" || echo "deploy of $RELEASE_TAG failed, the placeholder stays up"
fi
