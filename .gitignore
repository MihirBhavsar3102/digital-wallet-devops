# ---------------------------------------------------------------
# Terraform: state, local caches, plans, real variable files
# ---------------------------------------------------------------
# State can contain secrets and must live only in the S3 backend.
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
tfplan
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Variable files stay local by default, except the two environments' files below. Those hold no
# secrets (the database password and JWT secret are never variables), they are what makes staging
# and production differ, and CI needs them. Anything personal or secret goes in local.tfvars.
*.tfvars
*.tfvars.json
!*.tfvars.example
!staging.tfvars
!prod.tfvars
# NOTE: .terraform.lock.hcl is intentionally NOT ignored. Commit it.

# ---------------------------------------------------------------
# Secrets and local environment files
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.aws/

# ---------------------------------------------------------------
# Node (app/backend and app/frontend)
# ---------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.vite/
npm-debug.log*
# NOTE: upstream ignored backend/prisma/migrations/. We do NOT, because
# `prisma migrate deploy` needs them. package-lock.json is committed too.

# ---------------------------------------------------------------
# Evidence, scratch and editor/OS files
# ---------------------------------------------------------------
# Screenshots and scan output are kept outside the repo; this is a safety net.
evidence/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
